# Lokal Vercel-CLI-cache (skapas av `npx vercel` eller `vercel link`).
.vercel

# Miljöfiler med hemligheter – t.ex. ENTSO-E-token.
# Hemligheter ska bara ligga i Vercel environment variables, aldrig i Git.
.env
.env.local
.env*.local

# Next.js-byggutdata och cache.
.next
out
dist
/build
*.tsbuildinfo
next-env.d.ts

# Node-moduler. Ska aldrig checkas in.
node_modules
.pnp
.pnp.*

# Tester och loggar.
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS- och editorfiler.
.DS_Store
Thumbs.db
*.swp
*.pem
